library(terra)
library(sf)
library(randomForest)
set.seed(42)

# ---- 0. Settings ----------------------------------------------------
vec_dir   <- "ARCGIS_FILES_2/ARCGIS_FILES/Vector"
rast_dir  <- "ARCGIS_FILES_2/ARCGIS_FILES/Raster"
plant_dir <- "Metallophytes"

res_m              <- 50     # grid resolution in metres (CRS must be projected)
USE_RGB_EXPORTS    <- FALSE  # TRUE = keep 3-band 0-255 layers (colour exports) as predictors
MIN_PLANT_COVERAGE <- 0.9    # keep a plant layer only if >= this share of samples have a value
K_FOLDS            <- 5      # spatial CV folds
NTREE              <- 500
MAX_DIST_FROM_OUTLINE <- 5000  # metres; samples farther than this from the Makoko outline are dropped

# ---- 1. Soil samples (response) --------------------------------------
soil_samples <- st_read(file.path(vec_dir, "Soil_Samples__By_Lab_Method_.shp"),
                        quiet = TRUE)
n0 <- nrow(soil_samples)
soil_samples$Cu_ppm <- suppressWarnings(as.numeric(as.character(soil_samples$Cu_ppm)))
neg <- soil_samples$Cu_ppm[!is.na(soil_samples$Cu_ppm) & soil_samples$Cu_ppm < 0]
if (length(neg)) {
  cat("Negative Cu_ppm values (treated as missing / sentinel codes):\n")
  print(table(neg))
}
soil_samples <- soil_samples[!is.na(soil_samples$Cu_ppm) & soil_samples$Cu_ppm >= 0, ]
message(n0 - nrow(soil_samples), " of ", n0,
        " samples dropped for missing, non-numeric or negative Cu_ppm.")
print(summary(soil_samples$Cu_ppm))

target_crs <- st_crs(soil_samples)
if (isTRUE(st_is_longlat(soil_samples)))
  stop("Soil samples are in degrees. Transform to a projected CRS (metres) first, ",
       "e.g. soil_samples <- st_transform(soil_samples, <UTM EPSG>).")

# ---- 2. Study area and common 50 m grid ------------------------------
read_vec <- function(file) {
  st_transform(st_read(file.path(vec_dir, file), quiet = TRUE), target_crs)
}

makoko_v <- vect(read_vec("Resource_outlines_Makoko_resource_outline_2026.shp"))
soil_v   <- vect(soil_samples)

# Drop samples far from the outline (stray coordinates would blow up the grid)
d_out <- apply(as.matrix(distance(soil_v, makoko_v)), 1, min)
cat("\nDistance of samples to Makoko outline (m):\n")
print(summary(d_out))
keep <- d_out <= MAX_DIST_FROM_OUTLINE
message(sum(!keep), " of ", length(keep), " samples are > ", MAX_DIST_FROM_OUTLINE,
        " m from the outline and were dropped.")
soil_samples <- soil_samples[keep, ]
soil_v       <- vect(soil_samples)

# Grid covers the outline AND all samples, so no sample falls off the grid
e1 <- as.vector(ext(makoko_v))
e2 <- as.vector(ext(soil_v))
grid <- rast(
  ext(min(e1["xmin"], e2["xmin"]), max(e1["xmax"], e2["xmax"]),
      min(e1["ymin"], e2["ymin"]), max(e1["ymax"], e2["ymax"])),
  resolution = res_m,
  crs = crs(makoko_v)
)
if (ncell(grid) > 3e7) {
  print(ext(grid))
  stop("Grid has ", ncell(grid), " cells: the outline or samples cover an implausibly ",
       "large area. Check coordinates / CRS of soil_samples and the outline.")
}
values(grid) <- 1
message("Grid: ", ncell(grid), " cells at ", res_m, " m")

grid_area <- buffer(as.polygons(ext(grid), crs = crs(grid)), 2000)  # 2 km margin for resampling

# ---- 3. Helper: put any raster on the grid ----------------------------
to_grid <- function(r, method = "bilinear") {
  if (!nzchar(crs(r))) stop("Raster has no CRS assigned: ", sources(r)[1])
  area_r <- project(grid_area, crs(r))
  r_c <- tryCatch(crop(r, area_r), error = function(e) NULL)
  if (is.null(r_c)) {
    warning("No overlap with study area: ", basename(sources(r)[1]), " -> all NA")
    out <- rast(grid, nlyrs = nlyr(r))
    values(out) <- NA
    names(out) <- names(r)
    return(out)
  }
  project(r_c, grid, method = method)   # reproject + resample in one step
}

load_layer <- function(path, prefix) {
  g <- to_grid(rast(path))
  names(g) <- if (nlyr(g) == 1) prefix else paste0(prefix, "_b", seq_len(nlyr(g)))
  g
}

looks_rgb <- function(r) {
  if (nlyr(r) != 3) return(FALSE)
  g <- global(r, c("min", "max"), na.rm = TRUE)
  isTRUE(all(g$min >= 0) && all(g$max <= 255))
}

# ---- 4. Environmental rasters -----------------------------------------
env <- list(
  topo = load_layer(file.path(rast_dir,
                              "CopyRaster_OutRasterdataset_Topography_SRTM_Topo_Grid_Blue_Brown.tif"), "topo"),
  main_products = load_layer(file.path(rast_dir,
                                       "CopyRaster_OutRasterdataset_Main_Products_Q1104_Xcal2022_WFL_ARAD_U_tif.tif"), "main_products"),
  gravity = load_layer(file.path(rast_dir,
                                 "CopyRaster_OutRasterdataset_Ground_Gravity_GGRV_MP24_ALLm_BAf_RES500_tif.tif"), "gravity"),
  conductivity = load_layer(file.path(rast_dir,
                                      "CopyRaster_OutRasterdataset_BS_conductivity_Q1107_MP2022_WFL_HTEM_Cond1000_bs50m_tif.tif"), "conductivity")
)

for (nm in names(env)) {
  if (looks_rgb(env[[nm]])) {
    message("'", nm, "' has 3 bands with values in 0-255: looks like a colour-rendered export, ",
            "not measurements.", if (!USE_RGB_EXPORTS) " EXCLUDED from the model." else " Kept (USE_RGB_EXPORTS = TRUE).")
    if (!USE_RGB_EXPORTS) env[[nm]] <- NULL
  }
}

# ---- 5. Plant layers ---------------------------------------------------
plant_files <- list.files(plant_dir, pattern = "\\.tif$", full.names = TRUE)
stopifnot(length(plant_files) > 0)
plants <- do.call(c, lapply(plant_files, function(f)
  load_layer(f, make.names(tools::file_path_sans_ext(basename(f))))))
names(plants) <- make.unique(names(plants))

# ---- 6. Distance layers (metres, on the grid) ---------------------------
dist_layer <- function(file, nm) {
  d <- distance(grid, vect(read_vec(file)))
  names(d) <- nm
  d
}
dists <- c(
  dist_layer("Topography_Infrastructure.shp", "dist_infrastructure"),
  dist_layer("Topography_Railway.shp",        "dist_railway"),
  dist_layer("Topography_Drainage.shp",       "dist_drainage")
)

# ---- 7. Predictor stack -------------------------------------------------
predictors <- c(do.call(c, unname(env)), plants, dists)
message("Predictor stack: ", nlyr(predictors), " layers")

# ---- 8. Extract at samples ----------------------------------------------
vals <- terra::extract(predictors, soil_v, ID = FALSE)
dat  <- data.frame(Cu_ppm = soil_samples$Cu_ppm, crds(soil_v), vals)

# Plant coverage at the sample points
plant_names <- names(plants)
cover <- colMeans(!is.na(dat[, plant_names, drop = FALSE]))
cat("\nShare of samples with a value, per plant layer:\n")
print(round(cover, 3))
drop_plants <- names(cover)[cover < MIN_PLANT_COVERAGE]
if (length(drop_plants))
  message("Dropping ", length(drop_plants), " plant layers below ",
          MIN_PLANT_COVERAGE * 100, "% coverage at samples.")

pred_names <- setdiff(names(predictors), drop_plants)

# Drop constant columns (e.g. an all-255 background layer)
is_const <- sapply(dat[, pred_names, drop = FALSE],
                   function(v) length(unique(v[!is.na(v)])) <= 1)
if (any(is_const)) message("Dropping constant predictors: ",
                           paste(pred_names[is_const], collapse = ", "))
pred_names <- pred_names[!is_const]

dat <- dat[complete.cases(dat[, c("Cu_ppm", "x", "y", pred_names)]), ]
message("Rows used for modelling: ", nrow(dat), " of ", nrow(soil_samples))
if (nrow(dat) < 50) warning("Fewer than 50 usable rows: results will be unstable.")

dat$y_log <- log10(dat$Cu_ppm + 1)

# ---- 9. Random forest ----------------------------------------------------
rf <- randomForest(x = dat[, pred_names, drop = FALSE], y = dat$y_log,
                   ntree = NTREE, importance = TRUE)
print(rf)
cat("\nOOB RMSE (log10 scale):", round(sqrt(rf$mse[NTREE]), 3),
    "| OOB R2:", round(rf$rsq[NTREE], 3),
    "\n(OOB is optimistic when samples are spatially clustered.)\n")

# ---- 10. Spatially blocked CV (more honest error) ----------------------------
folds   <- kmeans(dat[, c("x", "y")], centers = K_FOLDS)$cluster
pred_cv <- rep(NA_real_, nrow(dat))
for (k in seq_len(K_FOLDS)) {
  tr <- folds != k
  m  <- randomForest(x = dat[tr, pred_names, drop = FALSE], y = dat$y_log[tr], ntree = NTREE)
  pred_cv[!tr] <- predict(m, dat[!tr, pred_names, drop = FALSE])
}
cv_rmse <- sqrt(mean((dat$y_log - pred_cv)^2))
cv_r2   <- 1 - sum((dat$y_log - pred_cv)^2) / sum((dat$y_log - mean(dat$y_log))^2)
cat("\nSpatial CV (", K_FOLDS, " blocks): RMSE (log10) = ", round(cv_rmse, 3),
    ", R2 = ", round(cv_r2, 3), "\n", sep = "")

# ---- 11. Variable importance ----------------------------------------------------
print(round(importance(rf)[order(-importance(rf)[, 1]), ], 3))
draw_imp <- function() {
  varImpPlot(rf, main = "Variable importance (Cu, log10)",
             n.var = min(20, length(pred_names)),
             cex = 1.2, cex.main = 1.5)
}
draw_imp()
png("makoko_cu_rf_importance.png", width = 2400, height = 1800, res = 300)
draw_imp()
dev.off()

# ---- 12. Predict across Makoko ----------------------------------------------------
pred_log <- predict(predictors[[pred_names]], rf, na.rm = TRUE)
pred_log <- mask(pred_log, makoko_v)
pred_cu  <- 10^pred_log - 1          # back to ppm
names(pred_cu) <- "Cu_ppm_pred"

draw_map <- function() {
  plot(pred_cu,
       main     = "",
       cex.main = 1.6,                                   # title size
       xlab = "Easting (m)", ylab = "Northing (m)", cex.lab = 1.3,
       plg      = list(title = "Cu (ppm)", title.cex = 1.4, cex = 1.3),  # colour bar
       pax      = list(cex.axis = 1.2))                  # axis tick labels
  plot(makoko_v, add = TRUE, border = "black", lwd = 1.5)

  sbar(1000, type = "bar", below = "m")                  # map scale bar: 1000 m (CRS is in metres)
  north()
}
draw_map()
png("makoko_cu_rf_map.png", width = 2400, height = 2000, res = 300)
draw_map()
dev.off()

writeRaster(pred_cu, "makoko_cu_rf_prediction.tif", overwrite = TRUE)
